{{! ================================================================
    HOME PAGE QUICK TOUR
    - Guided spotlight walkthrough of key home-page areas
    - Toggle: settings.enable_quick_tour (Theme settings > Home page)
    - Auto-shows ONCE PER BROWSER SESSION for first-time visitors
      (sessionStorage), and can be replayed anytime via the
      floating "Take a tour" button.
    - Vanilla JS/CSS, no dependencies. Matches the language-modal
      pattern: focus trap, ESC to close, aria-*, Hilti red accent,
      respects prefers-reduced-motion.
    - Steps auto-skip if their target element is not on the page,
      so it stays robust across theme settings.
    ================================================================ }}
{{#if settings.enable_quick_tour}}
<style>
  .hilti-tour-launch{position:fixed;right:20px;bottom:20px;z-index:9999990;display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:0;border-radius:0;background:#D2051E;color:#fff;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.18);transition:background .2s ease,transform .2s ease}
  .hilti-tour-launch:hover{background:#ab0115}
  .hilti-tour-launch:focus-visible{outline:3px solid rgba(210,5,30,.4);outline-offset:2px}
  .hilti-tour-launch svg{width:16px;height:16px;fill:currentColor;flex:none}
  .hilti-tour-overlay{position:fixed;inset:0;z-index:9999991;pointer-events:none;opacity:0;transition:opacity .25s ease}
  .hilti-tour-overlay.is-active{opacity:1;pointer-events:auto}
  /* Single spotlight element: the huge box-shadow spread dims the whole
     viewport EXCEPT the highlighted rectangle, and the inner ring is the
     red border. One element, no gaps, no geometry drift. */
  .hilti-tour-spot{position:fixed;top:0;left:0;width:0;height:0;border-radius:0;box-shadow:0 0 0 3px #D2051E, 0 0 0 9999px rgba(30,28,30,.62);pointer-events:none;transition:top .2s ease,left .2s ease,width .2s ease,height .2s ease}
  .hilti-tour-pop{position:fixed;z-index:9999992;max-width:320px;width:calc(100vw - 32px);background:#fff;border-radius:0;box-shadow:0 10px 34px rgba(0,0,0,.24);padding:18px 18px 14px;font-family:inherit;color:#524F53;transition:top .25s ease,left .25s ease}
  .hilti-tour-pop-step{font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#D2051E;margin:0 0 6px}
  .hilti-tour-pop-title{font-size:17px;font-weight:700;color:#2f2d30;margin:0 0 6px;line-height:1.3}
  .hilti-tour-pop-text{font-size:14px;line-height:1.5;margin:0 0 14px}
  .hilti-tour-pop-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .hilti-tour-dots{display:flex;gap:6px}
  .hilti-tour-dot{width:7px;height:7px;border-radius:50%;background:#d7cebd}
  .hilti-tour-dot.is-on{background:#D2051E}
  .hilti-tour-btns{display:flex;gap:8px}
  .hilti-tour-btn{border-radius:0;font-family:inherit;font-size:13px;font-weight:700;padding:8px 16px;cursor:pointer;border:1px solid transparent;transition:background .2s ease,color .2s ease,border-color .2s ease}
  .hilti-tour-btn-ghost{background:transparent;color:#898581;border-color:transparent}
  .hilti-tour-btn-ghost:hover{color:#524F53}
  .hilti-tour-btn-secondary{background:#f2f0ed;color:#524F53}
  .hilti-tour-btn-secondary:hover{background:#e4e0da}
  .hilti-tour-btn-primary{background:#D2051E;color:#fff}
  .hilti-tour-btn-primary:hover{background:#ab0115}
  .hilti-tour-btn:focus-visible{outline:3px solid rgba(210,5,30,.4);outline-offset:2px}
  .hilti-tour-skip{position:absolute;top:12px;right:12px;border:0;background:transparent;color:#a8a4a0;cursor:pointer;padding:4px;line-height:0;border-radius:0}
  .hilti-tour-skip:hover{color:#524F53}
  .hilti-tour-skip svg{width:16px;height:16px;fill:currentColor}
  @media (prefers-reduced-motion: reduce){
    .hilti-tour-overlay,.hilti-tour-spot,.hilti-tour-pop,.hilti-tour-launch{transition:none}
  }
</style>

<button type="button" class="hilti-tour-launch" id="hiltiTourLaunch" aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 15a1.25 1.25 0 110-2.5A1.25 1.25 0 0112 17zm1.6-6.1c-.6.4-.85.65-.85 1.35v.25h-1.5v-.35c0-1.2.5-1.8 1.25-2.3.55-.4.85-.65.85-1.2 0-.65-.5-1.1-1.25-1.1-.7 0-1.25.45-1.35 1.2l-1.45-.25C9 7.9 10.15 7 11.85 7c1.7 0 2.85.95 2.85 2.35 0 .95-.45 1.5-1.1 1.95z"/></svg>
  <span class="hilti-tour-launch-label">Take a tour</span>
