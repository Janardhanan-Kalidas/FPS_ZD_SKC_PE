<script type="text/javascript">
  {{! Category, section and promoted article image assets }}
  {{~#each categories}}
    {{~#if (asset id prefix='category-' suffix='.svg')~}}Theme.assets['category-{{id}}'] = "{{asset id prefix='category-' suffix='.svg'}}";{{~/if~}}
