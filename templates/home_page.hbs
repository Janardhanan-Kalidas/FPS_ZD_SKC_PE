      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
    <p class="hilti-tour-pop-step" id="hiltiTourStep"></p>
    <h2 class="hilti-tour-pop-title" id="hiltiTourTitle"></h2>
    <p class="hilti-tour-pop-text" id="hiltiTourText"></p>
    <div class="hilti-tour-pop-foot">
      <div class="hilti-tour-dots" id="hiltiTourDots" aria-hidden="true"></div>
      <div class="hilti-tour-btns">
        <button type="button" class="hilti-tour-btn hilti-tour-btn-secondary" id="hiltiTourBack">Back</button>
        <button type="button" class="hilti-tour-btn hilti-tour-btn-primary" id="hiltiTourNext">Next</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  var SEEN_KEY = 'hiltiQuickTourSeen'; // sessionStorage -> once per browser session

  {{! ------------------------------------------------------------------
      Translatable copy. When "Use translations" is on, each string is
      pulled from Zendesk dynamic content (create these keys in
      Admin > Dynamic content); otherwise the hardcoded English fallback
      is used. json_stringify safely escapes the values into JS literals.
      Dynamic content keys to create (all optional — fallbacks used if absent):
        tour_search_title / tour_search_text
        tour_topics_title / tour_topics_text
        tour_popular_title / tour_popular_text
        tour_language_title / tour_language_text
        tour_backtope_title / tour_backtope_text
        tour_btn_back / tour_btn_next / tour_btn_done / tour_btn_skip
        tour_launch_label / tour_step_counter  ("Step {n} of {total}")
      ------------------------------------------------------------------ }}
  var I18N = {
    searchTitle:   {{#if settings.use_translations}}{{json_stringify (dc 'tour_search_title')}}{{else}}{{json_stringify "Search the Knowledge Center"}}{{/if}},
    searchText:    {{#if settings.use_translations}}{{json_stringify (dc 'tour_search_text')}}{{else}}{{json_stringify "Start typing a product, error, or topic to instantly find articles across the PROFIS Engineering help center."}}{{/if}},
    topicsTitle:   {{#if settings.use_translations}}{{json_stringify (dc 'tour_topics_title')}}{{else}}{{json_stringify "Browse by topic"}}{{/if}},
    topicsText:    {{#if settings.use_translations}}{{json_stringify (dc 'tour_topics_text')}}{{else}}{{json_stringify "Jump into categories like Anchoring to Concrete, Facade, or Getting Started to explore grouped articles."}}{{/if}},
    popularTitle:  {{#if settings.use_translations}}{{json_stringify (dc 'tour_popular_title')}}{{else}}{{json_stringify "Popular & recent"}}{{/if}},
    popularText:   {{#if settings.use_translations}}{{json_stringify (dc 'tour_popular_text')}}{{else}}{{json_stringify "See promoted articles and the latest activity so you can catch up on what other engineers are reading."}}{{/if}},
    languageTitle: {{#if settings.use_translations}}{{json_stringify (dc 'tour_language_title')}}{{else}}{{json_stringify "Country & language"}}{{/if}},
    languageText:  {{#if settings.use_translations}}{{json_stringify (dc 'tour_language_text')}}{{else}}{{json_stringify "Switch your country and language here to see content localized for your region."}}{{/if}},
    backToPeTitle: {{#if settings.use_translations}}{{json_stringify (dc 'tour_backtope_title')}}{{else}}{{json_stringify "Back to PROFIS Engineering"}}{{/if}},
    backToPeText:  {{#if settings.use_translations}}{{json_stringify (dc 'tour_backtope_text')}}{{else}}{{json_stringify "This link takes you straight back to the PROFIS Engineering application whenever you are done here."}}{{/if}},
    btnBack:       {{#if settings.use_translations}}{{json_stringify (dc 'tour_btn_back')}}{{else}}{{json_stringify "Back"}}{{/if}},
    btnNext:       {{#if settings.use_translations}}{{json_stringify (dc 'tour_btn_next')}}{{else}}{{json_stringify "Next"}}{{/if}},
    btnDone:       {{#if settings.use_translations}}{{json_stringify (dc 'tour_btn_done')}}{{else}}{{json_stringify "Done"}}{{/if}},
    skipLabel:     {{#if settings.use_translations}}{{json_stringify (dc 'tour_btn_skip')}}{{else}}{{json_stringify "Skip tour"}}{{/if}},
    launchLabel:   {{#if settings.use_translations}}{{json_stringify (dc 'tour_launch_label')}}{{else}}{{json_stringify "Take a tour"}}{{/if}},
    stepCounter:   {{#if settings.use_translations}}{{json_stringify (dc 'tour_step_counter')}}{{else}}{{json_stringify "Step {n} of {total}"}}{{/if}}
  };

  // Step definitions. selector is tried in order; first match wins.
  // Any step whose target is missing is skipped automatically.
  var STEPS = [
    { sel: ['.hc-hero-search'], title: I18N.searchTitle, text: I18N.searchText },
    { sel: ['#content-blocks', '#custom-blocks'], title: I18N.topicsTitle, text: I18N.topicsText },
    { sel: ['.recent-activity', '.promoted-articles'], title: I18N.popularTitle, text: I18N.popularText },
    { sel: ['#hiltiLangTrigger'], title: I18N.languageTitle, text: I18N.languageText },
    { sel: ['.header-link'], title: I18N.backToPeTitle, text: I18N.backToPeText }
  ];

  var overlay = document.getElementById('hiltiTourOverlay');
  var launch  = document.getElementById('hiltiTourLaunch');
  if (!overlay || !launch) return;

  var pop   = document.getElementById('hiltiTourPop');
  var spot  = document.getElementById('hiltiTourSpot');
  var elStep = document.getElementById('hiltiTourStep');
  var elTitle = document.getElementById('hiltiTourTitle');
  var elText = document.getElementById('hiltiTourText');
  var elDots = document.getElementById('hiltiTourDots');
  var btnBack = document.getElementById('hiltiTourBack');
  var btnNext = document.getElementById('hiltiTourNext');
  var btnSkip = document.getElementById('hiltiTourSkip');

  // Apply translatable labels to static controls
  btnBack.textContent = I18N.btnBack;
  btnSkip.setAttribute('aria-label', I18N.skipLabel);
  var launchLabelEl = launch.querySelector('.hilti-tour-launch-label');
  if (launchLabelEl) launchLabelEl.textContent = I18N.launchLabel;
  launch.setAttribute('aria-label', I18N.launchLabel);

  var activeSteps = [];
  var idx = 0;
  var lastFocused = null;
  var PAD = 8; // spotlight padding around target

  function resolveTarget(step){
    for (var i = 0; i < step.sel.length; i++){
      var node = document.querySelector(step.sel[i]);
      if (node && node.offsetParent !== null) return node; // visible
    }
    return null;
  }

  function buildActiveSteps(){
    activeSteps = [];
    for (var i = 0; i < STEPS.length; i++){
      var node = resolveTarget(STEPS[i]);
      if (node) activeSteps.push({ node: node, data: STEPS[i] });
    }
  }

  function renderDots(){
    elDots.innerHTML = '';
    for (var i = 0; i < activeSteps.length; i++){
      var d = document.createElement('span');
      d.className = 'hilti-tour-dot' + (i === idx ? ' is-on' : '');
      elDots.appendChild(d);
    }
  }

  function positionFor(node){
    var r = node.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight;

    // Clamp the highlight to the viewport so an oversized or mis-measured
    // target can never produce a full-page box. getBoundingClientRect gives
    // viewport coordinates, which is exactly what position:fixed wants.
    var top = Math.max(r.top - PAD, 4);
    var left = Math.max(r.left - PAD, 4);
    var width = Math.max(Math.min(r.width + PAD * 2, vw - left - 4), 0);
    var height = Math.max(Math.min(r.height + PAD * 2, vh - top - 4), 0);

    spot.style.top = top + 'px';
    spot.style.left = left + 'px';
    spot.style.width = width + 'px';
    spot.style.height = height + 'px';

    // Place popover below the target when there is room, otherwise above
    var popH = pop.offsetHeight || 180;
    var popW = pop.offsetWidth || 320;
    var below = top + height + 12;
    var placeTop = (below + popH < vh) ? below : Math.max(top - popH - 12, 8);
    var placeLeft = Math.min(Math.max(left, 12), vw - popW - 12);
    pop.style.top = placeTop + 'px';
    pop.style.left = placeLeft + 'px';
  }

  function render(){
    var step = activeSteps[idx];
    if (!step) return;
    step.node.scrollIntoView({ behavior: 'smooth', block: 'center' });
    elStep.textContent = I18N.stepCounter.replace('{n}', idx + 1).replace('{total}', activeSteps.length);
    elTitle.textContent = step.data.title;
    elText.textContent = step.data.text;
    btnBack.style.visibility = idx === 0 ? 'hidden' : 'visible';
    btnNext.textContent = idx === activeSteps.length - 1 ? I18N.btnDone : I18N.btnNext;
    renderDots();
    // Wait for smooth scroll to settle before measuring
    setTimeout(function(){ positionFor(step.node); }, 260);
  }

  function open(){
    buildActiveSteps();
    if (!activeSteps.length) return;
    idx = 0;
    lastFocused = document.activeElement;
    overlay.classList.add('is-active');
    overlay.setAttribute('aria-hidden', 'false');
    document.addEventListener('keydown', onKey, true);
    window.addEventListener('resize', reposition);
    window.addEventListener('scroll', reposition, true);
    render();
    setTimeout(function(){ btnNext.focus(); }, 300);
  }

  function close(markSeen){
    overlay.classList.remove('is-active');
    overlay.setAttribute('aria-hidden', 'true');
    document.removeEventListener('keydown', onKey, true);
    window.removeEventListener('resize', reposition);
    window.removeEventListener('scroll', reposition, true);
    if (markSeen){ try { sessionStorage.setItem(SEEN_KEY, '1'); } catch(e){} }
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  function next(){ if (idx >= activeSteps.length - 1){ close(true); } else { idx++; render(); } }
  function back(){ if (idx > 0){ idx--; render(); } }
  function reposition(){ var s = activeSteps[idx]; if (s) positionFor(s.node); }

  function onKey(e){
    if (e.key === 'Escape'){ e.preventDefault(); close(true); }
    else if (e.key === 'ArrowRight'){ e.preventDefault(); next(); }
    else if (e.key === 'ArrowLeft'){ e.preventDefault(); back(); }
    else if (e.key === 'Tab'){
      // Simple focus trap across the popover controls
      var focusables = pop.querySelectorAll('button:not([style*="visibility: hidden"])');
      if (!focusables.length) return;
      var first = focusables[0], last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    }
  }

  btnNext.addEventListener('click', next);
  btnBack.addEventListener('click', back);
  btnSkip.addEventListener('click', function(){ close(true); });
  launch.addEventListener('click', open);

  // Auto-show once per browser session for first-time visitors
  function maybeAutoStart(){
    var seen = false;
    try { seen = sessionStorage.getItem(SEEN_KEY) === '1'; } catch(e){}
    if (seen) return;
    // Give the page (Alpine widgets, async templates) a moment to render targets
    setTimeout(open, 900);
  }
  if (document.readyState === 'complete'){ maybeAutoStart(); }
  else { window.addEventListener('load', maybeAutoStart); }
})();
</script>
{{/if}}
