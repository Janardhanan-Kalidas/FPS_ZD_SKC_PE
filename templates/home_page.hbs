<div class="hilti-tour-overlay" id="hiltiTourOverlay" role="dialog" aria-modal="true" aria-labelledby="hiltiTourTitle" aria-describedby="hiltiTourText" aria-hidden="true">
  <div class="hilti-tour-spot" id="hiltiTourSpot"></div>
