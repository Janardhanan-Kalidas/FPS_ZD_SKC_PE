# Local secrets for Zendesk tooling. Copy this file to `.env.local` and fill in
# real values. `.env.local` is git-ignored and must never be committed.
#
# The deploy/preview/list scripts source `.env` then `.env.local` automatically.

# OAuth access token for the Sandbox environment (help-profisengineering).
# Used by tooling/config/environments.json -> sandbox.tokenEnvVar.
# zcli authenticates with this as: Authorization: Bearer <token>
ZD_SANDBOX_OAUTH_TOKEN=your_oauth_access_token_here
